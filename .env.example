# Base URL of the Node.js API. The backend serves under /api/v1 (dev server proxies /api to it).
VITE_API_URL=/api/v1
# Mock mode:
#   true  - everything mocked in the browser, no backend needed (login: LEC00123 / password)
#   data  - REAL sign-in against the backend; dashboard/units/sessions stay mocked until those APIs exist
#   false - everything real
VITE_USE_MOCKS=data
